<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <EnableDefaultRazorComponentItems>false</EnableDefaultRazorComponentItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RazorBlade.Library\RazorBlade.Library.csproj" />
    <ProjectReference Include="..\..\src\RazorBlade.SourceGenerator\RazorBlade.SourceGenerator.csproj" 
                      OutputItemType="Analyzer" 
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Components\**\*.razor" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Components\**\*.razor" />
    <Content Remove="Components\**\*.razor" />
    <None Include="Components\**\*.razor" />
  </ItemGroup>

</Project>
